# Ignore OS-specific files
.DS_Store
Thumbs.db

# Ignore IDE-specific files
**/.vscode
**/.idea
**/.qodo

# Ignore misc junk
*.tmp
*.temp
*.bak
*.old
logs/

# Git metadata — must not be in the image
**/.git

# Dockerfiles themselves
.dockerignore
Dockerfile

# Rust build artefacts (source tree is COPYed fresh into the builder stage).
target/
**/target/
src/RustServer/data/**

# CI / dev helpers that don't belong in the build context.
**/.github
**/k6
**/scripts
**/eng
CHANGELOG.md
README.md
Taskfile.yaml
release-please-config.json
renovate.json
.release-please-manifest.json
